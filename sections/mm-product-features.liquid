<section class="mm-product-features">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mm-product-features__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="mm-product-features__grid">
      {%- for block in section.blocks -%}
        <div class="mm-product-features__card" {{ block.shopify_attributes }}>
          <span class="mm-product-features__icon">{{ block.settings.icon }}</span>
          <h3 class="mm-product-features__title">{{ block.settings.title }}</h3>
          <p class="mm-product-features__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Caratteristiche capo",
  "tag": "section",
  "class": "mm-section-product-features",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Perché amerai questo capo"
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Caratteristica",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icona",
          "default": "☀️"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo",
          "default": "Stile estivo"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Testo breve",
          "default": "Leggero e fresco per la bella stagione."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Caratteristiche capo",
      "blocks": [
        { "type": "feature", "settings": { "icon": "✨", "title": "Qualità premium", "text": "Materiali selezionati, cuciture resistenti." } },
        { "type": "feature", "settings": { "icon": "👗", "title": "Vestibilità comoda", "text": "Pensato per essere bello e pratico ogni giorno." } },
        { "type": "feature", "settings": { "icon": "🎨", "title": "Look versatile", "text": "Si abbina facilmente con tutto il guardaroba." } },
        { "type": "feature", "settings": { "icon": "🏷️", "title": "Firma originale", "text": "100% autentico, selezionato nel nostro outlet." } }
      ]
    }
  ]
}
{% endschema %}
