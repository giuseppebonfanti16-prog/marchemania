<section class="mm-product-steps">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mm-product-steps__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="mm-product-steps__grid">
      {%- for block in section.blocks -%}
        <div class="mm-product-steps__item" {{ block.shopify_attributes }}>
          <span class="mm-product-steps__num">{{ forloop.index }}</span>
          <span class="mm-product-steps__icon">{{ block.settings.icon }}</span>
          <h3 class="mm-product-steps__title">{{ block.settings.title }}</h3>
          <p class="mm-product-steps__text">{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Passi acquisto",
  "tag": "section",
  "class": "mm-section-product-steps",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Come funziona"
    }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Passo",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icona",
          "default": "🛒"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Titolo",
          "default": "Scegli taglia e colore"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Testo breve",
          "default": "Ordina in 30 secondi dal telefono."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Passi acquisto",
      "blocks": [
        { "type": "step", "settings": { "icon": "🛒", "title": "Scegli e ordina", "text": "Taglia, colore e quantità — ordine in pochi tap." } },
        { "type": "step", "settings": { "icon": "📦", "title": "Ricevi a casa", "text": "Spedizione gratuita, consegna in 2-5 giorni." } },
        { "type": "step", "settings": { "icon": "💳", "title": "Paga se ti piace", "text": "Pagamento alla consegna, nessun anticipo." } }
      ]
    }
  ]
}
{% endschema %}
