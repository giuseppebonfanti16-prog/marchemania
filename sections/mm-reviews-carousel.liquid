<section class="mm-reviews-carousel">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mm-reviews-carousel__heading">{{ section.settings.heading }}</h2>
    {%- endif -%}
    <div class="mm-reviews-carousel__track" data-mm-carousel>
      {%- for block in section.blocks -%}
        <article class="mm-reviews-carousel__card" {{ block.shopify_attributes }}>
          <div class="mm-reviews-carousel__stars" aria-hidden="true">★★★★★</div>
          <p class="mm-reviews-carousel__quote">"{{ block.settings.quote }}"</p>
          <p class="mm-reviews-carousel__author">{{ block.settings.author }}</p>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Recensioni carousel",
  "tag": "section",
  "class": "mm-section-reviews-carousel",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Dicono di noi"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recensione",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testo",
          "default": "Capo perfetto, qualità outlet vera!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Nome",
          "default": "Maria G."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Recensioni carousel",
      "blocks": [
        { "type": "review", "settings": { "quote": "Capo perfetto, identico alle foto!", "author": "Maria G." } },
        { "type": "review", "settings": { "quote": "Pagamento alla consegna comodissimo.", "author": "Patrizia L." } },
        { "type": "review", "settings": { "quote": "Qualità top, prezzo imbattibile.", "author": "Daniela R." } },
        { "type": "review", "settings": { "quote": "Spedizione veloce, tutto ok.", "author": "Francesca M." } }
      ]
    }
  ]
}
{% endschema %}
