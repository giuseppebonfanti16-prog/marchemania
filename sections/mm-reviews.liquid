<section class="mm-reviews">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <h2 class="mm-section-heading center">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.show_summary -%}
      <div class="mm-reviews__summary">
        <div class="mm-reviews__score">4.9</div>
        <div class="mm-reviews__stars" aria-hidden="true">★★★★★</div>
        <p class="mm-reviews__score-label">{{ section.settings.summary_text | default: 'Oltre 2.800 recensioni verificate' }}</p>
      </div>
    {%- endif -%}
    <div class="mm-reviews__grid">
      {%- for block in section.blocks -%}
        <div class="mm-reviews__card" {{ block.shopify_attributes }}>
          <div class="mm-reviews__stars" aria-label="{{ block.settings.rating }} stelle su 5">
            {%- for i in (1..5) -%}★{%- endfor -%}
          </div>
          <p class="mm-reviews__quote">"{{ block.settings.quote }}"</p>
          <p class="mm-reviews__author">{{ block.settings.author }}</p>
          <span class="mm-reviews__verified">✓ {{ 'marche_mania.reviews.verified' | t }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Recensioni",
  "tag": "section",
  "class": "mm-section-reviews",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Cosa dicono le nostre clienti"
    },
    {
      "type": "checkbox",
      "id": "show_summary",
      "label": "Mostra riepilogo valutazione",
      "default": true
    },
    {
      "type": "text",
      "id": "summary_text",
      "label": "Testo riepilogo",
      "default": "Valutazione 4.9/5 — oltre 2.800 recensioni verificate"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Schema colori",
      "default": "scheme-1"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Recensione",
      "settings": [
        {
          "type": "range",
          "id": "rating",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stelle",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Testo recensione",
          "default": "Qualità eccellente e prezzi imbattibili. Ho trovato la mia Nike preferita a metà prezzo!"
        },
        {
          "type": "text",
          "id": "author",
          "label": "Autore",
          "default": "Marco R."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Recensioni",
      "blocks": [
        { "type": "review", "settings": { "quote": "Qualità eccellente e prezzi imbattibili. Ho trovato la mia Nike preferita a metà prezzo!", "author": "Marco R." } },
        { "type": "review", "settings": { "quote": "Spedizione velocissima e pagamento alla consegna comodissimo. Consigliatissimo!", "author": "Giulia M." } },
        { "type": "review", "settings": { "quote": "Tommy Hilfiger originali a prezzi da outlet. Finalmente un negozio serio!", "author": "Luca B." } }
      ]
    }
  ]
}
{% endschema %}
