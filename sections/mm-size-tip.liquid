<section class="mm-size-tip">
  <div class="page-width">
    <div class="mm-size-tip__card">
      {%- if section.settings.heading != blank -%}
        <h2 class="mm-size-tip__heading">{{ section.settings.heading }}</h2>
      {%- endif -%}
      <div class="mm-size-tip__grid">
        {%- for block in section.blocks -%}
          <div class="mm-size-tip__item" {{ block.shopify_attributes }}>
            <span class="mm-size-tip__icon">{{ block.settings.icon }}</span>
            <p class="mm-size-tip__text">{{ block.settings.text }}</p>
          </div>
        {%- endfor -%}
      </div>
      {%- if section.settings.note != blank -%}
        <p class="mm-size-tip__note">{{ section.settings.note }}</p>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MM Guida taglie",
  "tag": "section",
  "class": "mm-section-size-tip",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Titolo",
      "default": "Non sai quale taglia?"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Nota finale",
      "default": "Scrivici su WhatsApp — ti aiutiamo a scegliere gratis."
    }
  ],
  "blocks": [
    {
      "type": "tip",
      "name": "Suggerimento",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icona",
          "default": "📏"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Testo",
          "default": "Consulta la tabella taglie nella descrizione."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "MM Guida taglie",
      "blocks": [
        { "type": "tip", "settings": { "icon": "📏", "text": "Confronta le misure con un capo che ti sta bene." } },
        { "type": "tip", "settings": { "icon": "👕", "text": "Preferisci comodo? Sali di mezza taglia." } },
        { "type": "tip", "settings": { "icon": "💬", "text": "Hai dubbi? Contattaci prima di ordinare." } }
      ]
    }
  ]
}
{% endschema %}
