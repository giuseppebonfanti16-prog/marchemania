{
  "sections": {
    "main": {
      "type": "main-product",
      "blocks": {
        "vendor": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{%- if product.vendor != blank -%}<span class=\"mm-vendor-tag\">{{ product.vendor }}</span>{%- endif -%}"
          }
        },
        "title": { "type": "title", "settings": {} },
        "price": { "type": "price", "settings": {} },
        "rating": {
          "type": "custom_liquid",
          "settings": {
            "custom_liquid": "{% render 'mm-product-rating-box' %}"
          }
        },
        "variant_picker": {
          "type": "variant_picker",
          "settings": {
            "picker_type": "button",
            "swatch_shape": "circle"
          }
        },
        "quantity_selector": {
          "type": "quantity_selector",
          "settings": {}
        },
        "buy_buttons": {
          "type": "buy_buttons",
          "settings": {
            "show_dynamic_checkout": false,
            "show_gift_card_recipient": false
          }
        },
        "description": { "type": "description", "settings": {} }
      },
      "block_order": [
        "vendor",
        "title",
        "price",
        "rating",
        "variant_picker",
        "quantity_selector",
        "buy_buttons",
        "description"
      ],
      "settings": {
        "enable_sticky_info": false,
        "color_scheme": "scheme-1",
        "media_size": "large",
        "constrain_to_viewport": false,
        "media_fit": "contain",
        "gallery_layout": "thumbnail_slider",
        "mobile_thumbnails": "show",
        "media_position": "left",
        "image_zoom": "lightbox",
        "hide_variants": false,
        "enable_video_looping": false,
        "padding_top": 16,
        "padding_bottom": 16
      }
    },
    "store": {
      "type": "mm-store-product",
      "blocks": {
        "p1": { "type": "pill", "settings": { "label": "Grandi firme" } },
        "p2": { "type": "pill", "settings": { "label": "Saldi outlet" } },
        "p3": { "type": "pill", "settings": { "label": "Spedizione gratis" } },
        "p4": { "type": "pill", "settings": { "label": "Pagamento alla consegna" } }
      },
      "block_order": ["p1", "p2", "p3", "p4"],
      "settings": {
        "heading": "Il nostro outlet fisico",
        "caption": "Stessa qualità del negozio — capi selezionati a mano dal nostro team."
      }
    },
    "reviews": {
      "type": "mm-reviews-carousel",
      "blocks": {
        "r1": { "type": "review", "settings": { "quote": "Capo perfetto, identico alle foto!", "author": "Maria G." } },
        "r2": { "type": "review", "settings": { "quote": "Pagamento alla consegna comodissimo.", "author": "Patrizia L." } },
        "r3": { "type": "review", "settings": { "quote": "Qualità top, prezzo imbattibile.", "author": "Daniela R." } },
        "r4": { "type": "review", "settings": { "quote": "Spedizione veloce, tutto ok.", "author": "Francesca M." } }
      },
      "block_order": ["r1", "r2", "r3", "r4"],
      "settings": { "heading": "Dicono di noi" }
    },
    "related-products": {
      "type": "related-products",
      "settings": {
        "heading": "Ti potrebbe piacere anche",
        "heading_size": "h2",
        "products_to_show": 4,
        "columns_desktop": 4,
        "columns_mobile": "2",
        "color_scheme": "scheme-1",
        "image_ratio": "portrait",
        "image_shape": "default",
        "show_secondary_image": true,
        "show_vendor": false,
        "show_rating": false,
        "padding_top": 32,
        "padding_bottom": 32
      }
    }
  },
  "order": [
    "main",
    "store",
    "reviews",
    "related-products"
  ]
}
